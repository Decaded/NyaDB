{
  "storage": {
    "databaseFolderName": "NyaDB",
    "databaseFileName": "database.json"
  },
  "formattingEnabled": true,
  "formattingStyle": "tab",
  "indentSize": 4,
  "encoding": "utf8",
  "enableConsoleLogs": false,
  "validateInput": true,
  "useAtomicWrites": true,
  "maxFileSize": 100,
  "writeDebounce": 10,
  "logLevel": "warn"
}
